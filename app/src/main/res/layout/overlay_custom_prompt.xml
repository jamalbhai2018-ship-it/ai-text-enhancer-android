<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Custom Prompt"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCancelPrompt"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_icon_button"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:contentDescription="@null" />
    </LinearLayout>

    <EditText
        android:id="@+id/etCustomPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="e.g. Translate to Spanish"
        android:minLines="2"
        android:padding="10dp"
        android:textColor="@color/text_light"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnApplyPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_menu_item"
        android:gravity="center"
        android:padding="12dp"
        android:text="Apply"
        android:textColor="@color/primary"
        android:textStyle="bold" />

</LinearLayout>
